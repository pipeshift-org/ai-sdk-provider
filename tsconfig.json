{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "baseUrl": ".",
    "paths": {
      "@pipeshift-org/ai-sdk-provider": [
        "./src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "examples",
    "tsup.config.ts",
    "vitest.config.ts"
  ]
}
